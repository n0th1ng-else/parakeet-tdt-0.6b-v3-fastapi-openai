# Parakeet TDT 0.6B ONNX - GPU Dockerfile
# High-performance speech transcription with NVIDIA CUDA

FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04

LABEL maintainer="Parakeet TDT"
LABEL description="ONNX-optimized speech transcription service (GPU/CUDA)"

# Prevent interactive prompts during build
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies and Python 3.13 from deadsnakes PPA
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3.13 \
    python3.13-venv \
    python3.13-dev \
    wget \
    xz-utils \
    && ln -sf /usr/bin/python3.13 /usr/bin/python \
    && ln -sf /usr/bin/python3.13 /usr/bin/python3 \
    && python -m ensurepip --upgrade \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Install FFmpeg 8.1 release build from BtbN/FFmpeg-Builds
ARG TARGETARCH
RUN if [ "${TARGETARCH}" = "arm64" ]; then ARCH=linuxarm64; else ARCH=linux64; fi \
    && ASSET_URL=$(wget -qO- https://api.github.com/repos/BtbN/FFmpeg-Builds/releases/tags/latest \
       | grep -o "https://[^\"]*ffmpeg-n8\.1[^\"]*-${ARCH}-lgpl-8\.1\.tar\.xz" | head -1) \
    && wget -q "${ASSET_URL}" -O /tmp/ffmpeg.tar.xz \
    && mkdir -p /tmp/ffmpeg && tar -xf /tmp/ffmpeg.tar.xz -C /tmp/ffmpeg --strip-components=1 \
    && cp /tmp/ffmpeg/bin/ffmpeg /usr/local/bin/ \
    && cp /tmp/ffmpeg/bin/ffprobe /usr/local/bin/ \
    && chmod +x /usr/local/bin/ffmpeg /usr/local/bin/ffprobe \
    && rm -rf /tmp/ffmpeg* \
    && apt-get purge -y wget xz-utils && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/* && apt-get clean

# Create non-root user for security
RUN useradd --create-home --shell /bin/bash parakeet
WORKDIR /app

# Copy requirements first for layer caching
COPY requirements.txt .

# Install Python dependencies with GPU support
# Replace onnxruntime with onnxruntime-gpu
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir onnx-asr[hub]>=0.10.0 \
    waitress>=3.0.0 \
    flask>=3.0.0 \
    openai>=1.0.0 \
    typing_extensions>=4.0.0 \
    psutil>=5.0.0 \
    requests>=2.0.0 \
    onnxruntime-gpu>=1.18.1 \
    numpy

# Copy application code
COPY app.py .
COPY templates/ templates/
COPY parakeet.png .

# Create directories for runtime
RUN mkdir -p temp_uploads models && \
    chown -R parakeet:parakeet /app

# Switch to non-root user
USER parakeet

# Environment variables
ENV HF_HOME=/app/models
ENV HF_HUB_CACHE=/app/models
ENV HF_HUB_DISABLE_SYMLINKS_WARNING=true
ENV PYTHONUNBUFFERED=1
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Expose the API port
EXPOSE 5092

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:5092/health')" || exit 1

# Run the application
CMD ["python", "app.py"]
